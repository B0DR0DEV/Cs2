<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Godot's Android .NET export template is built for .NET 9. -->
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>StrikeZone</RootNamespace>
    <AssemblyName>StrikeZone</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project compiles the core on its own; keep it out of the game assembly. -->
    <Compile Remove="tests/**" />
    <Compile Remove="build/**" />
  </ItemGroup>
</Project>
